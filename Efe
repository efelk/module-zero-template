}using UnityEngine;
using System.Collections.Generic;

public class LanguageManager : MonoBehaviour
{
    public static LanguageManager Instance;
    public Dictionary<string, string> localizedText = new Dictionary<string, string>();

    public string currentLanguage = "tr";

    void Awake()
    {
        if (Instance == null) Instance = this;
        LoadLanguage(currentLanguage);
    }

    public void LoadLanguage(string lang)
    {
        currentLanguage = lang;

        localizedText.Clear();
        if (lang == "tr")
        {
            localizedText.Add("login_button", "Giriş Yap");
            localizedText.Add("vip_title", "VİPO");
        }
        else
        {
            localizedText.Add("login_button", "Login");
            localizedText.Add("vip_title", "VIP");
        }
    }

    public string GetText(string key)
    {
        if (localizedText.ContainsKey(key))
            return localizedText[key];
        return key;
    }
